# ══════════════════════════════════════════════════════════════════════
# KORVEXCIO — variables de entorno
# ══════════════════════════════════════════════════════════════════════
# Copia este archivo a `.env` y rellena los valores reales.
#
# R5 / regla 6 del CLAUDE.md: el `.env` NUNCA se commitea, y en el nodo
# vive con permisos 600. Los secretos se pegan a mano en el servidor —
# no viajan por un formulario web ni por el chat.
#
# ⚠️ Lo que NO va aquí: el certificado .p12 y los tokens del proveedor
#    de e-CF. Esos viven en DocTypes de Frappe con fieldtype `Password`
#    y `Attach`, POR COMPANY (D19). Ver docs/07 §3.5.
# ══════════════════════════════════════════════════════════════════════

# ─── Bench / Docker Compose ───────────────────────────────────────────
# Proyecto de compose propio y aislado del de KORVIS (regla 3 del nodo).
COMPOSE_PROJECT_NAME=korvexcio

# Contraseña root de la MariaDB **de KORVEXCIO**.
# NO es la de KORVIS — son bases distintas, en proyectos distintos.
DB_ROOT_PASSWORD=

# Contraseña del usuario Administrator al crear un site nuevo.
ADMIN_PASSWORD=

# D2 cerrada en S0.5: v16 instaló y arrancó las apps del spike.
FRAPPE_VERSION=16
ERPNEXT_VERSION=16

# Imagen propia construida con `apps.json`. Nunca usar `latest`.
KORVEXCIO_IMAGE=korvexcio
PULL_POLICY=never

# ─── Puertos — SIEMPRE en loopback (regla 2 del nodo) ─────────────────
# Se entra por Tailscale, nunca publicando a la LAN.
HTTP_PUBLISH_PORT=127.0.0.1:8080

# ─── Límites de memoria (regla 4 del nodo) ────────────────────────────
# Tope ~6 GB para TODA la pila. No por falta de RAM: para que un worker
# desbocado no pueda ahogar a KORVIS, que corre un banco en vivo.
MEM_LIMIT_BACKEND=2g
MEM_LIMIT_DB=2g
MEM_LIMIT_WORKER=512m
MEM_LIMIT_REDIS=256m

# ─── Cifrado de PII (regla 8 del CLAUDE.md) ───────────────────────────
# AES-256-GCM con IV por registro, para cédula / fecha de nacimiento
# de la verificación de edad. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# 🔴 Si se pierde, los datos cifrados son irrecuperables. El backup de
#    la base NO la incluye. Va respaldada aparte, FUERA del servidor.
MASTER_ENCRYPTION_KEY=

# ─── Notificaciones ───────────────────────────────────────────────────
# Alertas de secuencias e-NCF por agotarse y de e-CF rechazados.
NOTIFY_EMAIL=
