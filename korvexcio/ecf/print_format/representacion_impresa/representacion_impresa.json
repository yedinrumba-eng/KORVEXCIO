{
 "creation": "2026-09-01 00:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<div class=\"page-break\">\n    {% set ecf = korvexcio_ecf_for_invoice(doc.name) %}\n    <div class=\"print-heading\">\n        <h2>{{ doc.company }}<br>\n            <small>RNC: {{ frappe.db.get_value(\"Company\", doc.company, \"tax_id\") or \"\" }}</small>\n        </h2>\n    </div>\n\n    <div class=\"row section-break\">\n        <div class=\"col-xs-6 column-break\">\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\"><label>Cliente</label></div>\n                <div class=\"col-xs-7 value\">{{ doc.customer_name }}</div>\n            </div>\n            {% if doc.tax_id %}\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\"><label>RNC del cliente</label></div>\n                <div class=\"col-xs-7 value\">{{ doc.tax_id }}</div>\n            </div>\n            {% endif %}\n        </div>\n        <div class=\"col-xs-6 column-break\">\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\"><label>Fecha</label></div>\n                <div class=\"col-xs-7 value\">{{ doc.posting_date }}</div>\n            </div>\n            {% if ecf %}\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\"><label>e-NCF</label></div>\n                <div class=\"col-xs-7 value\">{{ ecf.encf }}</div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\"><label>Estado DGII</label></div>\n                <div class=\"col-xs-7 value\">{{ ecf.estado }}</div>\n            </div>\n            {% else %}\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\"><label>e-NCF</label></div>\n                <div class=\"col-xs-7 value\">Pendiente de generar</div>\n            </div>\n            {% endif %}\n        </div>\n    </div>\n\n    <table class=\"table table-bordered\">\n        <thead>\n            <tr>\n                <th>Item</th>\n                <th class=\"text-right\">Cant</th>\n                <th class=\"text-right\">Precio</th>\n                <th class=\"text-right\">Monto</th>\n            </tr>\n        </thead>\n        <tbody>\n            {%- for row in doc.items -%}\n            <tr>\n                <td>{{ row.item_name }}</td>\n                <td class=\"text-right\">{{ row.qty }} {{ row.uom or row.stock_uom }}</td>\n                <td class=\"text-right\">{{ row.get_formatted(\"rate\", doc) }}</td>\n                <td class=\"text-right\">{{ row.get_formatted(\"amount\", doc) }}</td>\n            </tr>\n            {%- endfor -%}\n        </tbody>\n    </table>\n\n    <div class=\"row section-break\">\n        <div class=\"col-xs-6 column-break\"></div>\n        <div class=\"col-xs-6 column-break\">\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\"><label>ITBIS</label></div>\n                <div class=\"col-xs-7 text-right value\">{{ doc.total_taxes_and_charges }}</div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\"><label>Total</label></div>\n                <div class=\"col-xs-7 text-right value\">{{ doc.grand_total }}</div>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"row section-break\" style=\"margin-top: 30px;\">\n        <div class=\"col-xs-3 column-break\" style=\"text-align: left;\">\n            {% if ecf and ecf.qr_url %}\n            <img src=\"{{ korvexcio_qr_data_uri(ecf.qr_url) }}\" style=\"width: 110px; height: 110px;\">\n            {% else %}\n            <div style=\"font-size: 9px; color: #888; width: 110px;\">\n                QR pendiente -- se completa cuando la DGII confirme este e-CF (S2.7 bloqueado por D20).\n            </div>\n            {% endif %}\n        </div>\n        <div class=\"col-xs-9 column-break\"></div>\n    </div>\n</div>\n",
 "idx": 0,
 "module": "ECF",
 "modified": "2026-09-01 00:00:00.000000",
 "modified_by": "Administrator",
 "name": "Representacion Impresa e-CF",
 "owner": "Administrator",
 "print_format_builder": 0,
 "print_format_type": "Jinja",
 "standard": "Yes"
}
